$pipe out_data : $uint<32> $depth 2
$pipe in_data : $uint<32> $depth 2 

$operator $module [add2]
	$in (a b: $uint<32>) $out (sum: $uint<32>) $is
{
	sum := (a + b)
}

$module [check_daemon] $in() $out () $is
{
	$branchblock[lOoP] {
		$dopipeline $depth 9 $buffering 2 $fullrate
		$merge $entry $loopback $endmerge

	 	C0 := in_data
	 	C1 := in_data
	 	C2 := in_data
	 	C3 := in_data

		$call add2 (C0 C1) (Y1)
		$call add2 (C2 C3) (Y2)
		$call add2 (Y1 Y2) (Y)

		out_data := Y
	
		$while 1
	}
}
